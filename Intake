from pitop import EncoderMotor, ForwardDirection

class intake:
    def __init__(self, intake_port="M1", power = 0.8):
        self.intake_motor = EncoderMotor(intake_port, ForwardDirection.CLOCKWISE)
        self.power = power

    def intake(self, power):
        self.intake_motor.set_power(self.power)

    def reverse(self, power):
        self.intake_motor.set_power(-self.power)

    def stop(self):
        self.intake_motor.stop()